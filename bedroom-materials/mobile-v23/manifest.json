        "texture_repeat": false,
        "cull_mode": "CULL_DISABLED",
        "transparency": "TRANSPARENCY_DISABLED",
        "alpha_scissor_threshold": null,
        "backlight_enabled": true,
        "backlight": [
          0.1,
          0.16,
          0.045,
          1
        ],
        "subsurf_scatter_enabled": false,
        "metallic_specular": 0.23
      },
      "source_notes": [
        "Source atlas was opaque JPEG; leaf silhouette is modeled geometry, not rectangular alpha cards.",
        "No alpha file is needed. Every albedo pixel is opaque. Do not enable transparency or alpha scissors.",
        "Removed the old .85 × .505 = .429 roughness ambiguity. This PNG contains the final .80 target.",
        "Source leaf normal strength .35 is already baked. Godot normal_scale remains 1.0."
      ],
      "maps": {
