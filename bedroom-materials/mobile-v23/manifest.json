  "materials": {
    "DeskHoneyWood": {
      "uses": [
        "大雄书桌整面桌面、浅色抽屉"
      ],
      "replace_source_materials": [
        "V10_Desktop",
        "V10_Drawer"
      ],
      "uv": {
        "mode": "unique tabletop; retain original UV",
        "tabletop_uv_0_1_m": [
          0.6,
          1.18
        ],
        "drawer_uv_0_1_m": [
          0.168,
          0.306
        ],
        "not_for_automatic_member_remapping": true,
        "grain_axis": "V / image vertical",
        "note": "Whole desktop UV is unique. Keep existing UV and scale=(1,1,1); drawer coverage differs intentionally."
      },
      "godot_overrides": {
        "clearcoat_enabled": false,
        "texture_repeat": true,
        "metallic_specular": 0.35
      },
      "source_notes": [
        "Existing V10 desktop color/use patina retained at 62% residual amplitude.",
        "Existing 1254² honey cedar grain contributes real visible fiber variation; procedural composite emitted at 2048².",
        "Broad color variation does not become bump. Only detrended fine grain adds 11 μm modeled height."
      ],
      "maps": {
        "albedo": {
          "file": "materials/DeskHoneyWood/albedo.webp"
        },
        "normal": {
          "file": "materials/DeskHoneyWood/normal.png"
        },
